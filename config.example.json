{
    "watched_games": [
        "cs2.exe",
        "valorant.exe",
        "rocketleague.exe",
        "forzahorizon5.exe",
        "league of legends.exe"
    ],
    "watched_windows": [
        {
            "process_name": "javaw.exe",
            "title_contains": "minecraft",
            "display_name": "Minecraft"
        }
    ],
    "poll_interval_seconds": 1.5,
    "steam": {
        "enabled": true,
        "allowed_drives": ["C", "D"],
        "exclude_keywords": [
            "_commonredist",
            "easyanticheat",
            "battleye",
            "vc_redist",
            "directx",
            "dxsetup",
            "unins0",
            "crashreport",
            "crashhandler",
            "unitycrashhandler",
            "steamworks",
            "wallpaper_engine"
        ]
    },
    "epic": {
        "enabled": true,
        "exclude_keywords": [
            "unreal engine",
            "epic online services"
        ]
    },
    "obs": {
        "process_name": "obs64.exe",
        "path": "C:\\Program Files\\obs-studio\\bin\\64bit\\obs64.exe",
        "launch_args": ["--minimize-to-tray"],
        "startup_wait_seconds": 15,
        "websocket": {
            "host": "localhost",
            "port": 4455,
            "password": "YOUR_OBS_WEBSOCKET_PASSWORD"
        },
        "auto_split": {
            "enabled": false,
            "by": "time",
            "minutes": 20,
            "tolerance_seconds": 8,
            "megabytes": 4096,
            "tolerance_megabytes": 50
        }
    },
    "log_file": "autostart_script.log"
}
