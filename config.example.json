{
    "watched_games": [
        "cs2.exe",
        "valorant.exe",
        "rocketleague.exe",
        "forzahorizon5.exe",
        "league of legends.exe"
    ],
    "watched_windows": [
        {
            "process_name": "javaw.exe",
            "title_contains": "minecraft",
            "display_name": "Minecraft"
        }
    ],
    "poll_interval_seconds": 1.5,
    "organize_into_game_subfolders": false,
    "steam": {
        "enabled": true,
        "allowed_drives": ["C", "D"],
        "exclude_keywords": [
            "_commonredist",
            "easyanticheat",
            "battleye",
            "vc_redist",
            "directx",
            "dxsetup",
            "unins0",
            "crashreport",
            "crashhandler",
            "unitycrashhandler",
            "steamworks",
            "wallpaper_engine"
        ]
    },
    "epic": {
        "enabled": true,
        "exclude_keywords": [
            "unreal engine",
            "epic online services"
        ]
    },
    "gog": {
        "enabled": true,
        "exclude_keywords": []
    },
    "xbox": {
        "enabled": true,
        "install_dirs": ["C:\\XboxGames"],
        "exclude_keywords": []
    },
    "battlenet": {
        "enabled": false,
        "install_dirs": [],
        "exclude_keywords": []
    },
    "disk_space_guard": {
        "enabled": false,
        "minimum_free_gb": 10
    },
    "cleanup": {
        "delete_short_clips": {
            "enabled": false,
            "minimum_seconds": 20
        },
        "flag_silent_recordings": {
            "enabled": false,
            "peak_threshold": 0.02,
            "warn_after_seconds": 30
        }
    },
    "notifications": {
        "enabled": false
    },
    "post_record_transcode": {
        "enabled": false,
        "ffmpeg_path": "ffmpeg",
        "args": ["-map", "0", "-c:v", "libx264", "-crf", "23", "-preset", "veryfast", "-c:a", "aac", "-b:a", "192k"],
        "output_extension": "",
        "suffix": "_compressed",
        "delete_original": false
    },
    "obs": {
        "process_name": "obs64.exe",
        "path": "C:\\Program Files\\obs-studio\\bin\\64bit\\obs64.exe",
        "launch_args": ["--minimize-to-tray"],
        "startup_wait_seconds": 15,
        "websocket": {
            "host": "localhost",
            "port": 4455,
            "password": "YOUR_OBS_WEBSOCKET_PASSWORD"
        },
        "auto_split": {
            "enabled": false,
            "by": "time",
            "minutes": 20,
            "tolerance_seconds": 8,
            "megabytes": 4096,
            "tolerance_megabytes": 50
        },
        "manual_split": {
            "enabled": false,
            "buffer_seconds": 0
        },
        "custom_keybinds": [],
        "recovery": {
            "memory_limit_gb": 5,
            "cooldown_seconds": 30
        },
        "game_audio_capture": {
            "enabled": false,
            "input_name": "Game Audio"
        },
        "multi_track_audio": {
            "enabled": false,
            "profile_name": "OBS Auto Recorder",
            "tracks": [
                {"input_name": "Mic/Aux", "track": 1},
                {"input_name": "Desktop Audio", "track": 2},
                {"input_name": "Game Audio", "track": 3}
            ],
            "app_captures": []
        },
        "replay_buffer": {
            "enabled": false
        }
    },
    "log_file": "autostart_script.log"
}
